## You invoke this with --env android.release on the fastlane command
APP_NAME=Antimatter
APP_SCHEME=antimatter
BETA_BUILD=false
BUILD_FOR_RELEASE=true
COLLECT_NETWORK_METRICS=false
MAIN_APP_IDENTIFIER=chat.antimatter.app
REPLACE_ASSETS=true
SENTRY_ENABLED=false
SEPARATE_APKS=true
SHOW_ONBOARDING=true
SHOW_REVIEW=true
SUPPLY_PACKAGE_NAME=chat.antimatter.app
SUPPLY_TRACK=beta
SUPPLY_VALIDATE_ONLY=false