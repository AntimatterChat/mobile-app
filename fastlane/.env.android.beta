## You invoke this with --env android.beta on the fastlane command
APP_NAME="Antimatter Beta"
APP_SCHEME=antimatter
BETA_BUILD=true
BUILD_FOR_RELEASE=true
COLLECT_NETWORK_METRICS=true
MAIN_APP_IDENTIFIER=chat.antimatter.app.beta
REPLACE_ASSETS=false
SENTRY_ENABLED=false
SEPARATE_APKS=true
SHOW_ONBOARDING=true
SUPPLY_TRACK=alpha
SUPPLY_PACKAGE_NAME=chat.antimatter.app.beta
SUPPLY_VALIDATE_ONLY=false